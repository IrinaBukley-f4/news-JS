{
    "compilerOptions": {
      "baseUrl": ".",
      "target": "ES2020",
      "module": "ESNext",
      "moduleResolution": "node",
      "rootDir": "./src",
      "strict": true,
      "noImplicitAny": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "allowJs": true,
      "outDir": "./dist",
      "verbatimModuleSyntax": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
  }